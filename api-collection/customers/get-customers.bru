meta {
  name: Get Customers
  type: http
  seq: 2
}

get {
  url: {{base_url}}/customers?page=1&limit=10&search=&isActive=all
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
  ~search: Rahul
  ~isActive: true
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
}
