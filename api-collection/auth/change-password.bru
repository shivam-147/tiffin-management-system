meta {
  name: Change Password
  type: http
  seq: 6
}

put {
  url: {{base_url}}/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "currentPassword": "YourStrongPassword123",
    "newPassword": "NewStrongPassword456"
  }
}

settings {
  encodeUrl: true
}
